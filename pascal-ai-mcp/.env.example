# Azure OpenAI deployment endpoint.
AI_PROVIDER=azure-openai
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-10-21

# OpenRouter chat completions endpoint (used when AI_PROVIDER is omitted).
# You can still use AI_API_KEY / AI_BASE_URL / AI_MODEL aliases, but these
# OpenRouter names are preferred.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=~openai/gpt-5.5
OPENROUTER_FALLBACK_API_KEY=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_HTTP_REFERER=http://localhost:8788
OPENROUTER_APP_TITLE=Pascal AI MCP
OPENROUTER_TEMPERATURE=0.2

# HTTP server for this chat bridge.
AI_MCP_HOST=127.0.0.1
AI_MCP_PORT=8788

# /chat request body cap in MB. Keep in sync with the editor's 20MB source
# image limit (base64 inflates it to ~26.7MB).
AI_MCP_MAX_BODY_MB=28

# Graceful-shutdown budget (ms): how long SIGTERM/SIGINT waits for in-flight
# requests before closing SQLite and exiting non-zero.
AI_MCP_DRAIN_TIMEOUT_MS=5000

# One-time legacy import source. New/updated sessions are stored only in
# AI_MCP_DATABASE_FILE; this JSON file is never written after migration.
AI_MCP_SESSION_FILE=

# SQLite audit database for model attempt/token records. Leave unset to use
# ./.data/ai.db. Prompt and response bodies are not stored in this database.
AI_MCP_DATABASE_FILE=

# Durable /chat queue. Text payloads are cleared when a request reaches a
# terminal state. Images are decoded into private 0600 files under this
# directory and are never stored as Base64 in SQLite.
AI_MCP_REQUEST_ARTIFACTS_DIR=
AI_MCP_WORKER_CONCURRENCY=1
AI_MCP_MAX_QUEUE_DEPTH=100
# Heartbeat interval is one third of this value. Keep it above the longest
# expected event-loop stall; losing the lease cancels local execution.
AI_MCP_REQUEST_LEASE_MS=30000
AI_MCP_WORKER_POLL_MS=250

# Reference-template library. Defaults to pascal-ai-mcp/templates. The same
# directory is used by startup health checks and generation-time matching.
AI_MCP_TEMPLATES_DIR=

# MCP connection mode: http or stdio.
PASCAL_MCP_MODE=stdio

# Set PASCAL_MCP_MODE=http when Pascal MCP already runs separately, for example:
# bun packages/mcp/src/bin/pascal-mcp.ts --http --port 3917
PASCAL_MCP_URL=http://127.0.0.1:3917/mcp
PASCAL_MCP_TOKEN=

# Stdio mode starts a Pascal MCP process from this bridge.
PASCAL_MCP_COMMAND=bun
PASCAL_MCP_ARGS=../packages/mcp/src/bin/pascal-mcp.ts --stdio
PASCAL_DATA_DIR=

# Agent loop guard.
AI_MCP_MAX_TOOL_ROUNDS=8

# Input workflow limits. Confidence thresholds remain configurable until the
# production image/text evaluation set has been calibrated.
AI_MAX_CLARIFICATION_ROUNDS=3
# Workflow operation keys reserve repair:1 through repair:99.
AI_MAX_REPAIR_ROUNDS=2
AI_USABLE_CONFIDENCE=0.80
AI_PARTIAL_CONFIDENCE=0.50
